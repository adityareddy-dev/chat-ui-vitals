{
  "name": "chat-ui-vitals",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-perceived OpenTelemetry for a React LLM chat. Local prototype, not published.",
  "license": "MIT",
  "author": "Aditya Reddy <adityareddy.dev@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ./test/ts-imports.ts --test --test-reporter=spec test/*.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@types/node": "24.10.15",
    "typescript": "5.9.3"
  }
}
